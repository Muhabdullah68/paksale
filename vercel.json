{
  "installCommand": "curl -sL https://raw.githubusercontent.com/flutter-actions/setup-flutter/main/setup.sh | bash -s -- --flutter-version 3.29.0 && export PATH=\"$HOME/.flutter-sdk/bin:$HOME/.flutter-sdk/bin/cache/dart-sdk/bin:$PATH\" && flutter --version",
  "buildCommand": "export PATH=\"$HOME/.flutter-sdk/bin:$HOME/.flutter-sdk/bin/cache/dart-sdk/bin:$PATH\" && flutter pub get && flutter build web --release --base-href=/ --web-renderer=canvaskit",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2|woff|ttf|eot|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(flutter_service_worker.js|main.dart.js|flutter_bootstrap.js|version.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
